# WoTAgent 2.0
LLM_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-api-key-here

# Server capability; each task still selects thinking=true/false independently.
ENABLE_THINKING=true
REASONING_EFFORT=high
ENABLE_STREAMING=true

# Gradual agent decision strategy.
# rule: original deterministic Butler and execution baseline.
# hybrid: goal-driven Butler + bounded Health loop with rule fallback (default).
# agentic: experimental bounded extension point; safety layers remain mandatory.
AGENT_DECISION_MODE=hybrid
AGENT_SHADOW_MODE=false
HEALTH_AGENT_MAX_ITERATIONS=4
DEVICE_AGENT_MAX_ITERATIONS=4
BUTLER_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=16
AGENT_TOTAL_TIMEOUT_SECONDS=30
AGENT_LLM_TIMEOUT_SECONDS=12
AGENT_MAX_COMPENSATIONS=1
SUPERVISOR_MAX_ROUTES=2

# Optional price overrides in CNY per one million tokens.
# LLM_CACHE_HIT_PRICE_CNY_PER_MILLION=0.02
# LLM_CACHE_MISS_PRICE_CNY_PER_MILLION=1.0
# LLM_OUTPUT_PRICE_CNY_PER_MILLION=2.0

# stdio auto-spawns the simulator MCP child process.
MCP_TRANSPORT_MODE=stdio
# MCP_TRANSPORT_MODE=http
# MCP_SERVER_URL=http://127.0.0.1:18080/mcp

# Persistent runtime stores.
# WOTAGENT_CONVERSATION_DB=./data/conversations.db
# WOTAGENT_CHECKPOINT_DB=./data/agent_checkpoints.db
# WOTAGENT_RUN_DB=./data/agent_runs.db
