# ============================================================
# WoTAgent Prototype — Environment Configuration
# ============================================================
# Copy this file to .env and adjust as needed.
# All settings have safe defaults — you can start with an empty .env.

# --- LLM (OpenAI-compatible backend, e.g. DeepSeek) ---
# Model name. deepseek-chat supports tool calls natively.
LLM_MODEL=deepseek-v4-flash
# DeepSeek uses this base URL. For OpenAI change to https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com
# Your API key (required only when USE_MOCK_LLM=0)
OPENAI_API_KEY=your-api-key-here

# Optional CNY prices per one million tokens. Set all three when using a model
# that is not in the built-in experiment pricing table.
# LLM_CACHE_HIT_PRICE_CNY_PER_MILLION=0.02
# LLM_CACHE_MISS_PRICE_CNY_PER_MILLION=1.0
# LLM_OUTPUT_PRICE_CNY_PER_MILLION=2.0

# --- Thinking Mode ---
# Enable DeepSeek's chain-of-thought reasoning before each response.
# Toggle at runtime in the REPL with:  /think on  /think off
ENABLE_THINKING=true

# --- Streaming Mode ---
# Stream tokens progressively in the REPL (vs. waiting for the full response).
# Toggle at runtime with:  /stream on  /stream off
# Even when OFF, thinking content and tool events still appear live.
ENABLE_STREAMING=true

# --- Perception Auto-Execute ---
# When a perception rule triggers, automatically run Executor → Observer
# to carry out the action (requires LLM tokens). Off by default.
ENABLE_PERCEPTION_AUTO_EXEC=false

# --- MCP Transport ---
# How the agent connects to the IoT device simulator.
#
# Development (simulator on same machine):
#   stdio — Agent auto-spawns mcp_server.py as a subprocess. Zero config.
#
# Production (simulator on remote machine):
#   http  — Connect to simulator's MCP over HTTP. MCP_SERVER_URL must point
#           to the simulator's REST API (e.g. http://10.0.0.50:18080/mcp).
#
MCP_TRANSPORT_MODE=stdio
# MCP_SERVER_URL=http://10.0.0.50:18080/mcp   # Uncomment for HTTP mode

# --- Embeddings (for RAG) ---
# Provider: "hf" (HuggingFace) or "openai" (text-embedding-3-small)
EMBED_PROVIDER=hf
# Model name: BAAI/bge-small-zh-v1.5 for Chinese, or your preferred model
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# Cache directory for HuggingFace models
HF_HOME=./models
