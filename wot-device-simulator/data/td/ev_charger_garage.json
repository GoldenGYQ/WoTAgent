          "limitAmps": {"type": "number", "minimum": 6, "maximum": 32}
        },
        "required": ["limitAmps"],
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "charging": {"type": "boolean"},
    "limitAmps": {"type": "number"},
    "powerWatts": {"type": "number"}
  }
