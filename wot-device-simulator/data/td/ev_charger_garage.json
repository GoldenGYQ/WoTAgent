{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "id": "urn:dev:wot:ev-charger-001",
  "title": "Garage EV Charger",
  "location": "garage",
  "capabilities": ["energy", "ev_charging"],
  "actions": {
    "startCharging": {
      "input": {"type": "object", "properties": {}, "additionalProperties": false}
    },
    "stopCharging": {
      "input": {"type": "object", "properties": {}, "additionalProperties": false}
    },
    "setChargingLimit": {
      "input": {
        "type": "object",
