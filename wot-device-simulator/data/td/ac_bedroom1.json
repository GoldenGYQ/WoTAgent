              "heat",
              "fan",
              "auto",
              "dry"
            ]
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "on": {
      "type": "boolean"
    },
    "currentTemperature": {
      "type": "number"
    },
    "targetTemp": {
      "type": "number"
    },
    "mode": {
      "type": "string"
    }
  }
}
