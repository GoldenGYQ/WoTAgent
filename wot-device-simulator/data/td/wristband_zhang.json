{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "id": "urn:dev:wot:wristband-001",
  "title": "Zhang Wristband",
  "description": "Health wristband assigned to elderly-001.",
  "location": "A-101",
  "capabilities": [
    "health",
    "heart_rate",
    "blood_pressure",
    "spo2",
    "fall_detection"
  ],
  "actions": {
    "updateVitals": {
      "description": "Inject a simulated wristband sample.",
      "input": {
        "type": "object",
        "properties": {
          "heartRate": { "type": "number", "minimum": 30, "maximum": 220 },
          "bloodPressure": { "type": "string" },
          "spo2": { "type": "number", "minimum": 50, "maximum": 100 },
          "fallDetected": { "type": "boolean" },
          "observedAt": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "heartRate": { "type": "number" },
    "bloodPressure": { "type": "string" },
    "spo2": { "type": "number" },
    "fallDetected": { "type": "boolean" },
    "observedAt": { "type": "string" }
  }
}
