{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "id": "urn:dev:wot:mattress-002",
  "title": "Li Smart Mattress",
  "description": "Smart mattress assigned to elderly-002.",
  "location": "A-102",
  "capabilities": [
    "health",
    "sleep",
    "bed_occupancy"
  ],
  "actions": {
    "updateSleepState": {
      "description": "Inject a simulated mattress sample.",
      "input": {
        "type": "object",
        "properties": {
          "bedOccupancy": { "type": "boolean" },
          "sleepQuality": {
            "type": "string",
            "enum": ["good", "fair", "poor", "unknown"]
          },
          "observedAt": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "bedOccupancy": { "type": "boolean" },
    "sleepQuality": { "type": "string" },
    "observedAt": { "type": "string" }
  }
}
